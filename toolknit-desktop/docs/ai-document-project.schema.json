{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolknit.dev/schemas/ai-document-project-v1.json",
  "title": "ToolKnit AI Document Project v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "projectId",
    "title",
    "summary",
    "locale",
    "createdAt",
    "updatedAt",
    "revision",
    "pages",
    "assets"
  ],
  "properties": {
    "schema": { "const": "toolknit.ai-document" },
    "schemaVersion": { "const": 1 },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "title": { "type": "string", "maxLength": 300 },
    "summary": { "type": "string", "maxLength": 500 },
    "locale": { "enum": ["zh-CN", "en"] },
    "createdAt": { "type": "string", "maxLength": 80 },
    "updatedAt": { "type": "string", "maxLength": 80 },
    "revision": { "type": "integer", "minimum": 1 },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    },
    "assets": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "textColor": { "type": ["string", "null"], "pattern": "^#[0-9A-F]{6}$" },
        "backgroundColor": { "type": ["string", "null"], "pattern": "^#[0-9A-F]{6}$" },
        "borderColor": { "type": ["string", "null"], "pattern": "^#[0-9A-F]{6}$" },
        "dividerColor": { "type": ["string", "null"], "pattern": "^#[0-9A-F]{6}$" },
        "borderWidth": { "type": "number", "minimum": 0, "maximum": 12 },
        "dividerWidth": { "type": "number", "minimum": 0, "maximum": 12 },
        "padding": { "type": "number", "minimum": 0, "maximum": 80 },
        "opacity": { "type": "number", "minimum": 0.05, "maximum": 1 },
        "lineHeight": { "type": "number", "minimum": 1, "maximum": 3 }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "type", "layoutMode", "x", "y", "w", "h", "text", "fontSize", "bold", "align", "locked", "style"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "number": { "type": "string", "minLength": 1, "maxLength": 40 },
        "type": {
          "enum": ["title", "subtitle", "section-heading", "sub-heading", "body", "body-indent", "list-item", "image", "signature", "date", "divider", "page-header", "page-footer", "table-row", "note", "emphasis"]
        },
        "layoutMode": { "enum": ["flow", "absolute"] },
        "x": { "type": "number", "minimum": 0, "maximum": 794 },
        "y": { "type": "number", "minimum": 0, "maximum": 1123 },
        "w": { "type": "number", "minimum": 2, "maximum": 794 },
        "h": { "type": "number", "minimum": 2, "maximum": 1123 },
        "text": { "type": "string", "maxLength": 2000 },
        "label": { "type": "string", "maxLength": 300 },
        "assetId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "groupId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "fontSize": { "type": "number", "minimum": 6, "maximum": 96 },
        "bold": { "type": "boolean" },
        "align": { "enum": ["left", "center", "right"] },
        "locked": { "type": "boolean" },
        "style": { "$ref": "#/$defs/style" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "width", "height", "controls"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "width": { "type": "number", "minimum": 100, "maximum": 10000 },
        "height": { "type": "number", "minimum": 100, "maximum": 10000 },
        "controls": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/control" } }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relativePath", "mimeType", "width", "height", "bytes"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "relativePath": { "type": "string", "minLength": 1, "maxLength": 500 },
        "mimeType": { "enum": ["image/png", "image/jpeg"] },
        "width": { "type": "number", "minimum": 0, "maximum": 100000 },
        "height": { "type": "number", "minimum": 0, "maximum": 100000 },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 10485760 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
