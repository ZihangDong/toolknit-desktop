+CPPUNIT_TEST_FIXTURE(Test, testWordSpaceBalanceContext)
+{
+    struct Case { const char16_t* pText; sal_Int32 nStart; double nExpected; };
+    const Case aCases[] = {
+        { u"ABC DEF", 0, 35 }, { u"ABC DEF", 3, 35 },
+        { u"ABC  DEF", 0, 40 }, { u"ABC  DEF", 4, 40 },
+        { u"甲 ABC", 1, 40 }, { u"\U00020000 ABC", 2, 40 }
+    };
+    for (const auto& rCase : aCases)
+    {
+        KernArray aWidths = rCase.nStart == 0 ? KernArray{10, 20, 30, 35}
+                                            : KernArray{5, 15, 25, 35};
+        sw::Justify::BalanceCjkSpaces(aWidths, rCase.pText, rCase.nStart, 4, 10, false);
+        CPPUNIT_ASSERT_DOUBLES_EQUAL(rCase.nExpected, aWidths.back(), 0.001);
+    }
+    for (const auto& rCase : { std::pair{"word-space-context.docx", true},
+                              std::pair{"word-space-context-disabled.docx", false},
+                              std::pair{"character-spacing-absent.docx", false} })
+    {
+        createSwDoc(rCase.first);
+        uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+        uno::Reference<beans::XPropertySet> xSettings(
+            xFactory->createInstance(u"com.sun.star.document.Settings"_ustr), uno::UNO_QUERY_THROW);
+        CPPUNIT_ASSERT_EQUAL(rCase.second,
+            getProperty<bool>(xSettings, u"BalanceSpacesAndIdeographicSpaces"_ustr));
+    }
+}
