+            xFactory->createInstance(u"com.sun.star.document.Settings"_ustr), uno::UNO_QUERY_THROW);
+        CPPUNIT_ASSERT(!getProperty<bool>(xSettings, u"AdjustTableLineHeightsToGridHeight"_ustr));
