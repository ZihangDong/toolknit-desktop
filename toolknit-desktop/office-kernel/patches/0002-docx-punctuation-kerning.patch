+CPPUNIT_TEST_FIXTURE(Test, testNoPunctuationKerningImport)
+{
+    struct Case
+    {
+        const char* pFile;
+        bool bExpected;
+    };
+    // Run both values, the empty on/off element, and the OOXML default in
+    // sequence so a disabled setting cannot leak into the following document.
+    const Case aCases[] = {
+        { "punctuation-kerning-enabled.docx", true },
+        { "punctuation-kerning-disabled.docx", false },
+        { "punctuation-kerning-empty.docx", false },
+        { "punctuation-kerning-default.rtf", false },
+        { "character-spacing-absent.docx", true },
+    };
+    for (const auto& rCase : aCases)
+    {
+        createSwDoc(rCase.pFile);
+        uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+        uno::Reference<beans::XPropertySet> xSettings(
+            xFactory->createInstance(u"com.sun.star.document.Settings"_ustr), uno::UNO_QUERY_THROW);
+        CPPUNIT_ASSERT_EQUAL_MESSAGE(rCase.pFile, rCase.bExpected,
+                                    getProperty<bool>(xSettings, u"IsKernAsianPunctuation"_ustr));
+    }
+}
+
