diff --git a/sw/source/core/text/guess.cxx b/sw/source/core/text/guess.cxx
index 60e8adf1d6d10baeb7d8ac664084732367abb1e7..4502db0884bc8b0160a3f444e62a9e9aadb196f7 100644
--- a/sw/source/core/text/guess.cxx
+++ b/sw/source/core/text/guess.cxx
@@ -651,6 +651,24 @@ bool SwTextGuess::Guess( const SwTextPortion& rPor, SwTextFormatInfo &rInf,
             if (nCandidateWidth <= nNaturalWidth + wordClosingSpace(nNaturalCut))
                 ++nNaturalCut;
         }
+        // Kinsoku may require pulling the first character after an opening
+        // quote into the line. Word uses the available punctuation whitespace
+        // for that pair before moving the quote to the next line. Relax the
+        // normal half-em budget for exactly this pair, never a further word.
+        if (rInf.HasForbiddenChars() && m_nCutPos > nNaturalCut)
+        {
+            auto isOpeningQuote = [](sal_Unicode c) { return c == 0x201C || c == 0x2018; };
+            TextFrameIndex nPairEnd = nNaturalCut;
+            if (isOpeningQuote(rInf.GetChar(nNaturalCut)))
+                nPairEnd += TextFrameIndex(2);
+            else if (nNaturalCut > rInf.GetLineStart()
+                     && isOpeningQuote(rInf.GetChar(nNaturalCut - TextFrameIndex(1))))
+                nPairEnd += TextFrameIndex(1);
+            if (nPairEnd > nNaturalCut && nPairEnd <= m_nCutPos
+                && nPairEnd <= rInf.GetIdx() + nMaxLen
+                && GetAppCharClass().isLetterNumeric(rInf.GetText(), sal_Int32(nPairEnd) - 1))
+                nNaturalCut = nPairEnd;
+        }
         m_nCutPos = std::min(m_nCutPos, nNaturalCut);
     }
 
