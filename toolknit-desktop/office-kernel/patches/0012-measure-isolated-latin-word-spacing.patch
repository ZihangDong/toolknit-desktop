+CPPUNIT_TEST_FIXTURE(Test, testWordLatinWordSpaceMeasurement)
+{
+#if defined(_WIN32)
+    CPPUNIT_ASSERT(Application::GetDefaultDevice()->IsFontAvailable(u"Times New Roman"_ustr));
+    std::vector<sal_Int32> aLengths;
+    const OUString aExpected[] = {
+        u"[1] Alpha beta gamma delta epsilon"_ustr,
+        u"[1] Alpha beta gamma delta epsilon zeta"_ustr,
+        u"[1] Alpha beta gamma delta epsilon zeta eta"_ustr };
+    for (const char* pFile : { "word-latin-space-balance.docx",
+                              "word-latin-space-balance-disabled.docx" })
+    {
+        createSwDoc(pFile);
+        CPPUNIT_ASSERT_EQUAL(1, getPages());
+        xmlDocUniquePtr pDump = parseLayoutDump();
+        for (size_t i = 0; i < 3; ++i)
+        {
+            const OString aPath = "/root/page[1]/body/txt[" + OString::number((i + 1) * 2)
+                + "]/SwParaPortion/SwLineLayout[1]";
+            const sal_Int32 nLength = getXPath(pDump, aPath, "length").toInt32();
+            CPPUNIT_ASSERT_EQUAL(aExpected[i], getXPath(pDump, aPath, "portion").trim());
+            if (aLengths.size() < 3)
+                aLengths.push_back(nLength);
+            else
+                CPPUNIT_ASSERT_EQUAL(aLengths[i], nLength);
+        }
+    }
+#endif
+}
