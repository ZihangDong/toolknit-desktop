+    CPPUNIT_ASSERT(getProperty<bool>(xParagraph, u"ParaAutoSpaceDN"_ustr));
+    xParagraph->setPropertyValue(u"ParaIsCharacterDistance"_ustr, uno::Any(false));
+    CPPUNIT_ASSERT(!getProperty<bool>(xParagraph, u"ParaAutoSpaceDE"_ustr));
+    CPPUNIT_ASSERT(!getProperty<bool>(xParagraph, u"ParaAutoSpaceDN"_ustr));
