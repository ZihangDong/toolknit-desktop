     return new SvxScriptSpaceItem( *this );
 }
 
+bool SvxScriptSpaceItem::QueryValue(uno::Any& rValue, sal_uInt8 nMemberId) const
+{
+    switch (nMemberId & ~CONVERT_TWIPS)
+    {
+        case 0: rValue <<= GetValue(); break;
+        case 1: rValue <<= IsLetterSpace(); break;
+        case 2: rValue <<= IsDigitSpace(); break;
+        default: return false;
+    }
+    return true;
+}
+
+bool SvxScriptSpaceItem::PutValue(const uno::Any& rValue, sal_uInt8 nMemberId)
+{
+    bool bEnabled = false;
+    if (!(rValue >>= bEnabled))
+        return false;
+    const sal_uInt8 nMember = nMemberId & ~CONVERT_TWIPS;
+    if (!nMember)
+        SetValue(bEnabled);
+    else if (nMember == 1 || nMember == 2)
+    {
+        const sal_uInt16 nMask = nMember;
+        const sal_uInt16 nCurrent = SfxUInt16Item::GetValue();
+        SfxUInt16Item::SetValue(bEnabled ? nCurrent | nMask : nCurrent & ~nMask);
+    }
+    else
+        return false;
+    return true;
+}
+
 bool SvxScriptSpaceItem::GetPresentation(
         SfxItemPresentation /*ePres*/,
         MapUnit /*eCoreMetric*/, MapUnit /*ePresMetric*/,
