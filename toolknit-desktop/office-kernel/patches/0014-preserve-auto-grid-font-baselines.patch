+CPPUNIT_TEST_FIXTURE(Test, testWordAutoGridBaseline)
+{
+#if defined(_WIN32)
+    CPPUNIT_ASSERT(Application::GetDefaultDevice()->IsFontAvailable(u"SimSun"_ustr));
+    auto measure = [&](bool bWord, bool bOriginalAuto, float fPoints, bool bProportional)
+    {
+        createSwDoc();
+        uno::Reference<text::XTextDocument>(mxComponent, uno::UNO_QUERY_THROW)
+            ->getText()->setString(u"中文Example1"_ustr);
+        uno::Reference<beans::XPropertySet> xParagraph(getParagraph(1), uno::UNO_QUERY_THROW);
+        xParagraph->setPropertyValue(u"CharFontName"_ustr, uno::Any(u"SimSun"_ustr));
+        xParagraph->setPropertyValue(u"CharFontNameAsian"_ustr, uno::Any(u"SimSun"_ustr));
+        xParagraph->setPropertyValue(u"CharHeight"_ustr, uno::Any(fPoints));
+        xParagraph->setPropertyValue(u"CharHeightAsian"_ustr, uno::Any(fPoints));
+        xParagraph->setPropertyValue(u"SnapToGrid"_ustr, uno::Any(true));
+        style::LineSpacing aSpacing;
+        aSpacing.Mode = 3;
+        aSpacing.Height = bProportional ? 550 : 1101;
+        xParagraph->setPropertyValue(u"ParaLineSpacing"_ustr, uno::Any(aSpacing));
+        if (bOriginalAuto)
+            xParagraph->setPropertyValue(u"ParaInteropGrabBag"_ustr, uno::Any(
+                uno::Sequence<beans::PropertyValue>{comphelper::makePropertyValue(u"originalAutoLineSpacing"_ustr, true)}));
+        uno::Reference<beans::XPropertySet> xPage(getStyles(u"PageStyles"_ustr)->getByName(u"Standard"_ustr), uno::UNO_QUERY_THROW);
+        xPage->setPropertyValue(u"GridMode"_ustr, uno::Any(sal_Int16(1)));
+        xPage->setPropertyValue(u"GridBaseHeight"_ustr, uno::Any(sal_Int32(550)));
+        xPage->setPropertyValue(u"GridRubyHeight"_ustr, uno::Any(sal_Int32(0)));
+        xPage->setPropertyValue(u"StandardPageMode"_ustr, uno::Any(true));
+        uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+        uno::Reference<beans::XPropertySet> xSettings(
+            xFactory->createInstance(u"com.sun.star.document.Settings"_ustr), uno::UNO_QUERY_THROW);
+        xSettings->setPropertyValue(u"MsWordCompGridMetrics"_ustr, uno::Any(bWord));
+        uno::Reference<util::XRefreshable>(mxComponent, uno::UNO_QUERY_THROW)->refresh();
+        xmlDocUniquePtr pDump = parseLayoutDump();
+        const OString aPath = "/root/page[1]/body/txt[1]/SwParaPortion/SwLineLayout[1]";
+        return std::pair{getXPath(pDump, aPath, "height").toInt32(),
+                         getXPath(pDump, aPath, "ascent").toInt32()};
+    };
+    for (bool bProportional : {false, true})
+    {
+        const float fPoints = bProportional ? 10.5f : 16.0f;
+        const auto aReference = measure(false, false, fPoints, bProportional);
+        const auto aAutomatic = measure(true, true, fPoints, bProportional);
+        CPPUNIT_ASSERT_EQUAL(aReference.first, aAutomatic.first);
+        CPPUNIT_ASSERT_DOUBLES_EQUAL(aReference.second, aAutomatic.second, 1);
+        if (!bProportional)
+        {
+            const auto aFixed = measure(true, false, fPoints, false);
+            CPPUNIT_ASSERT(aFixed.second > aAutomatic.second + 20);
+        }
+    }
+#endif
+}
