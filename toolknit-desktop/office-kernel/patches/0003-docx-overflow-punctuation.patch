+++ b/sw/qa/extras/ooxmlimport/ooxmlimport.cxx
@@ -132,6 +132,20 @@ CPPUNIT_TEST_FIXTURE(Test, testNoPunctuationKerningImport)
     }
 }
 
+CPPUNIT_TEST_FIXTURE(Test, testOverflowPunctuationImport)
+{
+    createSwDoc("paragraph-overflow-punctuation.docx");
+    // Direct on/off, the empty on/off element, absent/default, inherited
+    // values, and direct formatting overriding an inherited value.
+    const bool aExpected[] = { false, true, true, true, false, true, false, true, false };
+    for (size_t i = 0; i < SAL_N_ELEMENTS(aExpected); ++i)
+        CPPUNIT_ASSERT_EQUAL_MESSAGE("paragraph " + std::to_string(i + 1), aExpected[i],
+            getProperty<bool>(getParagraph(static_cast<sal_Int32>(i + 1)), u"ParaIsHangingPunctuation"_ustr));
+
+    createSwDoc("character-spacing-absent.docx");
+    CPPUNIT_ASSERT(getProperty<bool>(getParagraph(1), u"ParaIsHangingPunctuation"_ustr));
+}
