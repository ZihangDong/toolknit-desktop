+CPPUNIT_TEST_FIXTURE(Test, testWordPageBreakBeforeSpacing)
+{
+    createSwDoc("word-page-break-spacing.docx");
+    CPPUNIT_ASSERT_EQUAL(4, getPages());
+    xmlDocUniquePtr pDump = parseLayoutDump();
+    // Explicit pageBreakBefore retains 400 twips. Natural pagination with the
+    // same before spacing still collapses it; zero spacing stays zero.
+    const sal_Int32 aUpper[] = { 0, 400, 0, 0 };
+    for (size_t i = 0; i < SAL_N_ELEMENTS(aUpper); ++i)
+    {
+        const OString aPath = "/root/page[" + OString::number(i + 1)
+            + "]/body/txt[1]/infos/prtBounds";
+        CPPUNIT_ASSERT_EQUAL(aUpper[i], getXPath(pDump, aPath, "top").toInt32());
+    }
+}
