diff --git a/sw/qa/extras/ooxmlimport/ooxmlimport.cxx b/sw/qa/extras/ooxmlimport/ooxmlimport.cxx
index bc4a0409b3a547dc774858cdc29f61afa40bf8c2..e32b69215339488c78c23940320249b5c2debd80 100644
--- a/sw/qa/extras/ooxmlimport/ooxmlimport.cxx
+++ b/sw/qa/extras/ooxmlimport/ooxmlimport.cxx
@@ -25,6 +25,8 @@
 #include <com/sun/star/drawing/EnhancedCustomShapeAdjustmentValue.hpp>
 #include <com/sun/star/drawing/PolyPolygonBezierCoords.hpp>
 #include <com/sun/star/lang/XServiceInfo.hpp>
+#include <com/sun/star/lang/XMultiServiceFactory.hpp>
+#include <com/sun/star/text/CharacterCompressionType.hpp>
 #include <com/sun/star/style/BreakType.hpp>
 #include <com/sun/star/style/DropCapFormat.hpp>
 #include <com/sun/star/style/XStyleFamiliesSupplier.hpp>
@@ -76,6 +78,33 @@ public:
     }
 };
 
+CPPUNIT_TEST_FIXTURE(Test, testCharacterSpacingControlImport)
+{
+    struct Case
+    {
+        const char* pFile;
+        sal_Int16 nExpected;
+    };
+    // Import compressed, uncompressed and absent settings consecutively to
+    // detect accidental sharing of typography between documents.
+    const Case aCases[] = {
+        { "character-spacing-punctuation.docx", text::CharacterCompressionType::PUNCTUATION_ONLY },
+        { "character-spacing-none.docx", text::CharacterCompressionType::NONE },
+        { "character-spacing-kana.docx", text::CharacterCompressionType::PUNCTUATION_AND_KANA },
+        { "character-spacing-absent.docx", text::CharacterCompressionType::NONE },
+        { "character-spacing-invalid.docx", text::CharacterCompressionType::NONE },
+    };
+    for (const auto& rCase : aCases)
+    {
+        createSwDoc(rCase.pFile);
+        uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+        uno::Reference<beans::XPropertySet> xSettings(
+            xFactory->createInstance(u"com.sun.star.document.Settings"_ustr), uno::UNO_QUERY_THROW);
+        CPPUNIT_ASSERT_EQUAL_MESSAGE(rCase.pFile, rCase.nExpected,
+                                    getProperty<sal_Int16>(xSettings, u"CharacterCompressionType"_ustr));
+    }
+}
+
 CPPUNIT_TEST_FIXTURE(Test, testImageHyperlink)
 {
