--- a/sw/qa/extras/ooxmlimport/ooxmlimport.cxx
+++ b/sw/qa/extras/ooxmlimport/ooxmlimport.cxx
@@ -443,6 +443,25 @@ CPPUNIT_TEST_FIXTURE(Test, testWordClosingHangingPriority)
 #endif
 }
 
+CPPUNIT_TEST_FIXTURE(Test, testWordScriptSpaceLineEnd)
+{
+#if defined(_WIN32)
+    CPPUNIT_ASSERT(Application::GetDefaultDevice()->IsFontAvailable(u"SimSun"_ustr));
+    CPPUNIT_ASSERT(Application::GetDefaultDevice()->IsFontAvailable(u"Times New Roman"_ustr));
+    createSwDoc("word-script-space-line-end.docx");
+    xmlDocUniquePtr pDump = parseLayoutDump();
+    for (sal_Int32 i : {1, 2})
+    {
+        const OString aPath = "/root/page[1]/body/txt[" + OString::number(i)
+            + "]/SwParaPortion/SwLineLayout[1]";
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(8), getXPath(pDump, aPath, "length").toInt32());
+        assertXPath(pDump, aPath + "/*[@type='PortionType::Kern'][last()]", "width", u"60");
+    }
+    assertXPath(pDump, "/root/page[1]/body/txt[3]/SwParaPortion/SwLineLayout[1]"
+        "/*[@type='PortionType::Kern']", 0);
+#endif
+}
+
 CPPUNIT_TEST_FIXTURE(Test, testImageHyperlink)
 {
     createSwDoc("image-hyperlink.docx");
diff --git a/sw/source/core/text/porrst.cxx b/sw/source/core/text/porrst.cxx
index a17d345eaf0912aefeba222a60dbc752f008f9e0..713b9dfd42296faa9345cef77f9c66a8ba23c64b 100644
--- a/sw/source/core/text/porrst.cxx
+++ b/sw/source/core/text/porrst.cxx
@@ -311,7 +311,11 @@ void SwKernPortion::FormatEOL( SwTextFormatInfo &rInf )
         rInf.SetLast( FindPrevPortion( rInf.GetRoot() ) );
     if( m_nKern < 0 )
         Width( -m_nKern );
-    else
+    // Word automatic script spacing already fitted inside this line. Keep
+    // its trailing advance when the following script moves to the next line;
+    // zeroing it redistributes a quarter em over the justified text. Ordinary
+    // character kerning (sentinel 4) retains the existing end-of-line rule.
+    else if (m_nScriptSpaceRemainder == 4)
         Width( 0 );
     rInf.GetLast()->FormatEOL( rInf );
 }
