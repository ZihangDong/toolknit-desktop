{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ToolKnit Desktop [F12 Test]",
        "width": 1100,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "devtools": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI --use-fake-ui-for-media-stream",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "capabilities": [
        "default",
        "screenshot-windows",
        "desktop-feedback",
        {
          "identifier": "qa-devtools",
          "description": "Local DevTools shortcut for explicitly requested test installers.",
          "windows": ["main"],
          "permissions": ["core:webview:allow-internal-toggle-devtools"]
        }
      ]
    }
  }
}
