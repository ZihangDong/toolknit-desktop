{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "toolknit-desktop",
  "version": "3.1.0",
  "identifier": "com.toolknit.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ToolKnit Desktop",
        "width": 1100,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "devtools": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI --use-fake-ui-for-media-stream",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' blob: data: http://127.0.0.1:*; media-src 'self' blob: data: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:*; font-src 'self' data: asset: http://asset.localhost https://asset.localhost",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$DATA/ToolKnit/custom-fonts/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "../src/core/opencc/LICENSE.txt",
      "../src/core/opencc/NOTICE.txt",
      "resources/qpdf/qpdf.exe",
      "resources/qpdf/qpdf30.dll",
      "resources/qpdf/concrt140.dll",
      "resources/qpdf/msvcp140.dll",
      "resources/qpdf/msvcp140_1.dll",
      "resources/qpdf/msvcp140_2.dll",
      "resources/qpdf/msvcp140_atomic_wait.dll",
      "resources/qpdf/msvcp140_codecvt_ids.dll",
      "resources/qpdf/vcruntime140.dll",
      "resources/qpdf/vcruntime140_1.dll",
      "resources/qpdf/NOTICE.txt",
      "resources/qpdf/LICENSE.html",
      "resources/whisper/NOTICE.txt",
      "resources/whisper/LICENSE.txt",
      "resources/whisper/Release/whisper-cli.exe",
      "resources/whisper/Release/whisper.dll",
      "resources/whisper/Release/ggml.dll",
      "resources/onnxruntime/onnxruntime.dll",
      "resources/onnxruntime/DirectML.dll",
      "resources/whisper/Release/ggml-base.dll",
      "resources/whisper/Release/ggml-cpu-alderlake.dll",
      "resources/whisper/Release/ggml-cpu-cannonlake.dll",
      "resources/whisper/Release/ggml-cpu-cascadelake.dll",
      "resources/whisper/Release/ggml-cpu-haswell.dll",
      "resources/whisper/Release/ggml-cpu-icelake.dll",
      "resources/whisper/Release/ggml-cpu-sandybridge.dll",
      "resources/whisper/Release/ggml-cpu-skylakex.dll",
      "resources/whisper/Release/ggml-cpu-sse42.dll",
      "resources/whisper/Release/ggml-cpu-x64.dll"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true,
        "template": "./windows/installer.nsi",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
