toolknit-desktop/cli/resources/fonts/
toolknit-desktop/cli/*.tgz

# README 资源误命名副本
toolknit-desktop/docs/assets/readme-hero.gif.gif

# GitHub 只识别根目录 .github；子应用目录里的副本不提交
toolknit-desktop/.github/
